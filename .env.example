DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Resend (OTP + transactional). Without these, OTP APIs return 503.
# 1) resend.com → API Keys → create key → RESEND_API_KEY=re_...
# 2) Domains → add & verify your domain (DNS)
# 3) RESEND_FROM_EMAIL must use that domain. Prefer a real human name +
#    a replyable personal address over a brand/no-reply mailbox — a 1:1
#    "From" (matching Reply-To) is one of the strongest signals that lands
#    mail in Gmail's Primary tab instead of Promotions.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Prakhar from Trenchers <prakhar@trenchers.ai>"
# Reply-To for the survey invite. Should match the From identity above.
RESEND_REPLY_TO="prakhar@trenchers.ai"
WAITLIST_APP_NAME="Trenchers"

# Optional: restrict /analytics sign-in to this domain (default: trenchers.ai)
# INTERNAL_ANALYTICS_EMAIL_DOMAIN="trenchers.ai"

# ---- Bot protection on signup (all optional; each layer is a no-op until set) ----
#
# Cloudflare Turnstile — invisible human verification on the OTP-request path.
# 1) dash.cloudflare.com → Turnstile → Add site → Widget mode: "Managed".
# 2) Site Key is public (ships to the browser); Secret Key stays server-side.
# The widget renders in interaction-only mode, so real users see nothing
# unless Cloudflare needs an active challenge. Without these, signup behaves
# exactly as before (no verification step).
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# Per-IP rate limiting (Upstash Redis / Vercel KV). Without these, rate
# limiting is DISABLED. Add the "Upstash" integration in the Vercel
# dashboard (Storage tab) — it injects these automatically. The KV_* names
# from the legacy Vercel KV integration are also accepted.
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

