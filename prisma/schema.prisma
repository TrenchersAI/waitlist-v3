generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WaitlistSubscriber {
  id           String               @id @default(cuid())
  email        String               @unique
  referralCode String               @unique
  referralsMade Int                 @default(0)
  referredById String?
  referredBy   WaitlistSubscriber?  @relation("WaitlistReferrals", fields: [referredById], references: [id])
  referrals    WaitlistSubscriber[] @relation("WaitlistReferrals")
  isVerified   Boolean              @default(false)
  verifiedAt   DateTime?
  otpCode      String?
  otpExpiresAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  surveyInvite SurveyInvite?
  betaInvite   BetaInvite?

  @@index([referredById])
  // Analytics aggregates date-bucket by createdAt / verifiedAt on every
  // dashboard load. As the table grows these indexes prevent the queries
  // from degrading to sequential scans.
  @@index([createdAt])
  @@index([verifiedAt])
}

/// One row per (campaign, subscriber). Created up-front by the send script
/// so we can join Resend webhook events back to the subscriber via
/// `resendMsgId`, and so the survey URL token resolves to exactly one row.
model SurveyInvite {
  id           String   @id @default(cuid())
  campaign     String   @default("trader-research-v1")
  subscriberId String   @unique
  subscriber   WaitlistSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  token        String   @unique
  resendMsgId  String?  @unique
  sentAt       DateTime?
  /// Set when the follow-up reminder email goes out (a second send to
  /// non-completers). Separate from `sentAt` so first-send analytics stay
  /// intact, and so the reminder batch is resumable: a crashed 10-hour run
  /// re-runs and skips anyone already reminded.
  reminderSentAt DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  unsubscribedAt DateTime?
  createdAt    DateTime @default(now())
  response     SurveyResponse?

  @@index([campaign])
  @@index([sentAt])
}

/// Created the first time a recipient opens the survey URL. We keep it
/// even if they bail before submitting — the absence of `completedAt` plus
/// the set of `SurveyAnswer` rows tells us where they dropped.
model SurveyResponse {
  id              String   @id @default(cuid())
  inviteId        String   @unique
  invite          SurveyInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  startedAt       DateTime @default(now())
  lastTouchedAt   DateTime @default(now())
  completedAt     DateTime?
  ipCountry       String?
  userAgent       String?
  twitter         String?
  telegram        String?
  countryAnswer   String?
  answers         SurveyAnswer[]

  @@index([completedAt])
}

/// One row per (response, question). On-blur autosave from the client
/// upserts here so we know which fields the user actually engaged with
/// before bailing.
model SurveyAnswer {
  id          String   @id @default(cuid())
  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionKey String
  valueJson   Json
  answeredAt  DateTime @default(now())

  @@unique([responseId, questionKey])
  @@index([questionKey])
}

/// One row per (campaign, subscriber) for the beta-access invite. Created
/// up-front by the segmentation step so the send is resumable and so every
/// recipient has a stable token before a single email goes out.
///
/// Kept separate from SurveyInvite rather than adding columns to it: the
/// two campaigns have different audiences and different suppression rules,
/// and a bounce on the beta invite must not silently rewrite survey
/// analytics.
model BetaInvite {
  id           String   @id @default(cuid())
  campaign     String   @default("beta-access-v1")
  subscriberId String   @unique
  subscriber   WaitlistSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  /// Send wave from src/lib/beta-invite.ts. Stored (not recomputed) so the
  /// record of which cohort we mailed survives later list changes.
  wave         String

  /// Opaque per-recipient token. Backs the tracked "open the terminal"
  /// link, so a click is attributable first-party without Resend's
  /// click-tracking rewrite (which is itself a Promotions-tab signal).
  token        String   @unique

  resendMsgId  String?  @unique
  sentAt       DateTime?
  /// Terminal failure at send time (Resend rejected it). Distinct from a
  /// bounce, which happens after acceptance.
  failedAt     DateTime?
  failReason   String?

  deliveredAt  DateTime?
  openedAt     DateTime?
  /// First time the recipient hit the tokenized invite link. This is the
  /// real engagement signal for this campaign since open tracking is off.
  clickedAt    DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  unsubscribedAt DateTime?

  /// When beta access was actually provisioned for this address.
  accessGrantedAt DateTime?
  /// First observed sign-in on beta.trenchers.ai with this email. The
  /// bottom of the funnel: invited -> delivered -> clicked -> signed in.
  activatedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaign])
  @@index([wave])
  @@index([sentAt])
  @@index([clickedAt])
  @@index([accessGrantedAt])
  @@index([activatedAt])
}

/// Raw audit log of Resend webhook events. We also fold the relevant
/// timestamps onto SurveyInvite for fast dashboard reads — this table is
/// for forensics / debugging when a number looks wrong.
model EmailEvent {
  id          String   @id @default(cuid())
  resendMsgId String
  type        String
  payload     Json
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([resendMsgId])
  @@index([type])
}

/** OTP challenge for /analytics (team @trenchers.ai only). Not waitlist data. */
model AnalyticsOtpChallenge {
  email        String   @id
  otpCode      String
  otpExpiresAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnalyticsSession {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
