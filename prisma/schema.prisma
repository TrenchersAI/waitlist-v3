generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WaitlistSubscriber {
  id           String               @id @default(cuid())
  email        String               @unique
  referralCode String               @unique
  referralsMade Int                 @default(0)
  referredById String?
  referredBy   WaitlistSubscriber?  @relation("WaitlistReferrals", fields: [referredById], references: [id])
  referrals    WaitlistSubscriber[] @relation("WaitlistReferrals")
  isVerified   Boolean              @default(false)
  verifiedAt   DateTime?
  otpCode      String?
  otpExpiresAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  surveyInvite SurveyInvite?
  betaInvite   BetaInvite?

  /// Subscriber-level unsubscribe token, and the reason it exists at THIS
  /// level rather than on an invite. Opt-out tokens used to live only on
  /// SurveyInvite/BetaInvite, so the 1,801 subscribers holding neither had a
  /// `List-Unsubscribe` header and footer link that resolved to a 404. A
  /// recipient who wants out and cannot get out reports spam instead, and
  /// mailbox providers weigh a complaint far more heavily than an
  /// unsubscribe -- on a whole-list send that is the fastest way to damage a
  /// domain that also carries our OTP login mail.
  unsubscribeToken String?          @unique
  /// Global opt-out, mirroring the invite-level columns the unsubscribe route
  /// already writes. Global because someone opting out of one mail means all
  /// of them; a per-campaign flag would re-mail them on the next send.
  unsubscribedAt   DateTime?

  /// Seventh send: the public-beta Falcon CLAIM campaign. Tracked HERE and not
  /// on BetaInvite, where the previous six live, because this one goes to the
  /// whole waitlist (14,199) rather than a wave: 3,740 of those addresses have
  /// no BetaInvite row to hang a column on. Own columns for the same reason
  /// every send before it has them -- without them a bounce on the newest
  /// rewrites the delivery record of the oldest.
  falconClaimSentAt       DateTime?
  falconClaimResendMsgId  String?
  falconClaimDeliveredAt  DateTime?
  falconClaimBouncedAt    DateTime?
  falconClaimComplainedAt DateTime?
  /// Resend refused the send outright (address already on its suppression
  /// list). The message never left, so it costs no reputation, but the person
  /// is unreachable and must stop appearing in pending counts.
  falconClaimSuppressedAt DateTime?

  @@index([referredById])
  // Analytics aggregates date-bucket by createdAt / verifiedAt on every
  // dashboard load. As the table grows these indexes prevent the queries
  // from degrading to sequential scans.
  @@index([createdAt])
  @@index([verifiedAt])
  @@index([unsubscribedAt])
  @@index([falconClaimSentAt])
  @@index([falconClaimResendMsgId])
}

/// One row per (campaign, subscriber). Created up-front by the send script
/// so we can join Resend webhook events back to the subscriber via
/// `resendMsgId`, and so the survey URL token resolves to exactly one row.
model SurveyInvite {
  id           String   @id @default(cuid())
  campaign     String   @default("trader-research-v1")
  subscriberId String   @unique
  subscriber   WaitlistSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  token        String   @unique
  resendMsgId  String?  @unique
  sentAt       DateTime?
  /// Set when the follow-up reminder email goes out (a second send to
  /// non-completers). Separate from `sentAt` so first-send analytics stay
  /// intact, and so the reminder batch is resumable: a crashed 10-hour run
  /// re-runs and skips anyone already reminded.
  reminderSentAt DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  unsubscribedAt DateTime?
  createdAt    DateTime @default(now())
  response     SurveyResponse?

  @@index([campaign])
  @@index([sentAt])
}

/// Created the first time a recipient opens the survey URL. We keep it
/// even if they bail before submitting — the absence of `completedAt` plus
/// the set of `SurveyAnswer` rows tells us where they dropped.
model SurveyResponse {
  id              String   @id @default(cuid())
  inviteId        String   @unique
  invite          SurveyInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  startedAt       DateTime @default(now())
  lastTouchedAt   DateTime @default(now())
  completedAt     DateTime?
  ipCountry       String?
  userAgent       String?
  twitter         String?
  telegram        String?
  countryAnswer   String?
  answers         SurveyAnswer[]

  @@index([completedAt])
}

/// One row per (response, question). On-blur autosave from the client
/// upserts here so we know which fields the user actually engaged with
/// before bailing.
model SurveyAnswer {
  id          String   @id @default(cuid())
  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionKey String
  valueJson   Json
  answeredAt  DateTime @default(now())

  @@unique([responseId, questionKey])
  @@index([questionKey])
}

/// One row per (campaign, subscriber) for the beta-access invite. Created
/// up-front by the segmentation step so the send is resumable and so every
/// recipient has a stable token before a single email goes out.
///
/// Kept separate from SurveyInvite rather than adding columns to it: the
/// two campaigns have different audiences and different suppression rules,
/// and a bounce on the beta invite must not silently rewrite survey
/// analytics.
model BetaInvite {
  id           String   @id @default(cuid())
  campaign     String   @default("beta-access-v1")
  subscriberId String   @unique
  subscriber   WaitlistSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  /// Send wave from src/lib/beta-invite.ts. Stored (not recomputed) so the
  /// record of which cohort we mailed survives later list changes.
  wave         String

  /// Opaque per-recipient token. Backs the tracked "open the terminal"
  /// link, so a click is attributable first-party without Resend's
  /// click-tracking rewrite (which is itself a Promotions-tab signal).
  token        String   @unique

  resendMsgId  String?  @unique
  sentAt       DateTime?
  /// Terminal failure at send time (Resend rejected it). Distinct from a
  /// bounce, which happens after acceptance.
  failedAt     DateTime?
  failReason   String?

  deliveredAt  DateTime?
  openedAt     DateTime?
  /// First time the recipient hit the tokenized invite link. This is the
  /// real engagement signal for this campaign since open tracking is off.
  clickedAt    DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  unsubscribedAt DateTime?
  /// Resend dropped the send because the address is on its suppression
  /// list, usually from a prior hard bounce on any campaign. Distinct from
  /// a bounce: the message never left, so it costs no reputation, but the
  /// person is unreachable and should stop appearing in pending counts.
  suppressedAt DateTime?

  /// Second send: the "signup issue" reminder, mailed to invitees who had
  /// not signed in. Tracked on separate columns rather than a second row
  /// because `subscriberId` is unique per subscriber, and separate columns
  /// keep the first send's delivery stats intact rather than overwriting
  /// them. Same reason SurveyInvite carries its own `reminderSentAt`.
  /// Not unique: a unique index here would buy nothing (Resend ids are
  /// already distinct) and adding one to a populated table triggers a
  /// data-loss warning for no benefit. A plain index is all the webhook
  /// lookup needs.
  reminderSentAt      DateTime?
  reminderResendMsgId String?
  reminderDeliveredAt DateTime?
  reminderOpenedAt    DateTime?
  reminderBouncedAt   DateTime?
  reminderComplainedAt DateTime?

  /// Third send: the activation nudge, to people who have already signed
  /// in. Own columns for the same reason the reminder has them: three sends
  /// on one row must keep independent delivery stats.
  nudgeSentAt      DateTime?
  nudgeResendMsgId String?
  nudgeDeliveredAt DateTime?
  nudgeOpenedAt    DateTime?
  nudgeBouncedAt   DateTime?
  nudgeComplainedAt DateTime?

  /// Fourth send: the product-change announcement. Own columns for the
  /// same reason the reminder and nudge have them. Four sends now share one
  /// row, and without separate columns a bounce on the newest would rewrite
  /// the delivery record of the oldest.
  featureSentAt      DateTime?
  featureResendMsgId String?
  featureDeliveredAt DateTime?
  featureOpenedAt    DateTime?
  featureBouncedAt   DateTime?
  featureComplainedAt DateTime?

  /// Fifth send: the Falcon tier-upgrade thank-you. Own columns for the same
  /// reason every send before it has them. Five sends now share one row, so
  /// without separate columns a bounce on the newest rewrites the delivery
  /// record of the oldest.
  falconSentAt      DateTime?
  falconResendMsgId String?
  falconDeliveredAt DateTime?
  falconOpenedAt    DateTime?
  falconBouncedAt   DateTime?
  falconComplainedAt DateTime?

  /// When the Falcon tier was actually applied to this person's terminal
  /// account. Distinct from `accessGrantedAt`, which is login access only.
  /// Written by scripts/watch-falcon-grants.ts, which is what makes the
  /// mail's "you now hold Falcon" true for someone who signs up AFTER
  /// being mailed. Null means they either have no account yet or the
  /// watcher has not reached them.
  falconTierGrantedAt DateTime?

  /// When beta access was actually provisioned for this address.
  accessGrantedAt DateTime?
  /// First observed sign-in on beta.trenchers.ai with this email. The
  /// bottom of the funnel: invited -> delivered -> clicked -> signed in.
  activatedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaign])
  @@index([wave])
  @@index([sentAt])
  @@index([clickedAt])
  @@index([accessGrantedAt])
  @@index([activatedAt])
  @@index([reminderSentAt])
  @@index([reminderResendMsgId])
  @@index([nudgeSentAt])
  @@index([nudgeResendMsgId])
  @@index([featureSentAt])
  @@index([featureResendMsgId])
  @@index([falconSentAt])
  @@index([falconResendMsgId])
  @@index([falconTierGrantedAt])
}

/// Raw audit log of Resend webhook events. We also fold the relevant
/// timestamps onto SurveyInvite for fast dashboard reads — this table is
/// for forensics / debugging when a number looks wrong.
model EmailEvent {
  id          String   @id @default(cuid())
  resendMsgId String
  type        String
  payload     Json
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([resendMsgId])
  @@index([type])
}

/** OTP challenge for /analytics (team @trenchers.ai only). Not waitlist data. */
model AnalyticsOtpChallenge {
  email        String   @id
  otpCode      String
  otpExpiresAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnalyticsSession {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// A send to an audience that is NOT the waitlist.
///
/// WHY THIS EXISTS. Every campaign so far has been tracked on
/// `WaitlistSubscriber`, because every audience so far WAS the waitlist. The
/// Founding Falcon cohort is defined by trading volume instead, and 37 of its
/// 109 members never joined the waitlist at all -- they signed up to the
/// product directly. Hanging another column off `WaitlistSubscriber` would
/// silently drop exactly the people the campaign most wants to reach.
///
/// Keyed by EMAIL rather than by a user id, because that is the only
/// identifier both databases share: the cohort is computed in the terminal's
/// database and mailed from this one.
///
/// Deliberately generic. The Founding Falcon send is the first of five planned
/// segments, and the next four are the same shape.
model CampaignSend {
  id       String @id @default(cuid())
  campaign String
  email    String

  /// Per-recipient unsubscribe token. Carried HERE because a recipient who is
  /// not on the waitlist has no `WaitlistSubscriber.unsubscribeToken`, and a
  /// `List-Unsubscribe` header that 404s turns someone who wants out into a
  /// spam complaint -- the single most expensive signal a sending domain can
  /// produce.
  token String @unique

  sentAt         DateTime?
  resendMsgId    String?
  deliveredAt    DateTime?
  openedAt       DateTime?
  bouncedAt      DateTime?
  complainedAt   DateTime?
  suppressedAt   DateTime?
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per person per campaign, so a re-run tops up new members and can
  /// never hand anyone a second copy.
  @@unique([campaign, email])
  @@index([campaign, sentAt])
  @@index([resendMsgId])
  @@index([email])
}
